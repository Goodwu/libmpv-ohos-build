diff --git a/video/out/ohos_common.c b/video/out/ohos_common.c
--- a/video/out/ohos_common.c
+++ b/video/out/ohos_common.c
@@ -39,0 +40,8 @@
+static void invalidate_output_color(struct vo_ohos_state *ctx)
+{
+    ctx->color_space_valid = false;
+    ctx->metadata_type_valid = false;
+    ctx->static_metadata_valid = false;
+    ctx->hdr_white_point_valid = false;
+    ctx->sdr_white_point_valid = false;
+}
@@ -211,0 +211,11 @@
+    // Rotation/queue reconfiguration can reset the consumer color state
+    // without going through the VO reconfig callback.  Do not trust the
+    // cached producer-side state when NativeWindow reports another color
+    // space; make the next rendered frame rewrite the complete contract.
+    if (color_space_get_result == 0 && actual_color_space != color_space) {
+        MP_WARN(ctx,
+                "OHOS consumer color mismatch: desired=%d actual=%d; "
+                "invalidating dynamic color cache\n",
+                color_space, actual_color_space);
+        invalidate_output_color(ctx);
+    }
