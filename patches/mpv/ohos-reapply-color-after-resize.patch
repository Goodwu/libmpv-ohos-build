diff --git a/video/out/ohos_common.h b/video/out/ohos_common.h
--- a/video/out/ohos_common.h
+++ b/video/out/ohos_common.h
@@ -32,3 +32,4 @@ bool vo_ohos_surface_size(struct vo *vo, int *w, int *h);
 struct pl_color_space vo_ohos_preferred_csp(struct vo *vo);
 bool vo_ohos_set_color(struct vo *vo, struct mp_image_params *params);
 void vo_ohos_invalidate_color(struct vo *vo);
+void vo_ohos_reapply_color(struct vo *vo);
diff --git a/video/out/ohos_common.c b/video/out/ohos_common.c
--- a/video/out/ohos_common.c
+++ b/video/out/ohos_common.c
@@ -334,4 +334,10 @@ void vo_ohos_invalidate_color(struct vo *vo)
     ctx->static_metadata_valid = false;
     ctx->hdr_white_point_valid = false;
     ctx->sdr_white_point_valid = false;
 }
+
+void vo_ohos_reapply_color(struct vo *vo)
+{
+    struct mp_image_params params = vo_get_current_params(vo);
+    vo_ohos_set_color(vo, &params);
+}
